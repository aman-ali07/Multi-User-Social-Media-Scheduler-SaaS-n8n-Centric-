# ============================================================================
# n8n Environment Variables
# ============================================================================
# Copy this to .env and fill in values before running docker-compose up.
# This file is gitignored — add .env to .gitignore if not already there.

# n8n host config
N8N_HOST=your-n8n-instance-domain
N8N_EDITOR_BASE_URL=https://your-n8n-instance-domain
N8N_WEBHOOK_URL=https://your-n8n-instance-domain/

# Meta/Facebook API
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Internal webhook secret (shared between scheduler and internal workflows)
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=generate_a_random_secret_here

# Frontend URL (for OAuth redirects)
FRONTEND_URL=https://your-frontend.vercel.app

# Supabase Auth URL (for token verification in n8n workflows)
SUPABASE_AUTH_URL=https://dzbkiqtzyofzcfqgundy.supabase.co/auth/v1/user
