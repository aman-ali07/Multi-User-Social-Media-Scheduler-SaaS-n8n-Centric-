# ============================================================================
# n8n Environment Variables
# ============================================================================
# Copy this to .env and fill in values before running docker-compose up.
# For production, use a proper secrets manager or n8n's credential store.

# n8n host config
N8N_HOST=your-n8n-instance-domain
N8N_EDITOR_BASE_URL=https://your-n8n-instance-domain
N8N_WEBHOOK_URL=https://your-n8n-instance-domain/

# Meta/Facebook API
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_TOKEN_URL=https://graph.facebook.com/v21.0/oauth/access_token

# Proxy secret (shared between Next.js and n8n proxy workflows)
# Generate with: openssl rand -hex 32
N8N_PROXY_SECRET=generate_a_random_secret_here

# Internal webhook secret (shared between scheduler and internal workflows)
# Generate with: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=generate_a_random_secret_here

# Frontend
FRONTEND_URL=https://your-frontend.vercel.app

# Supabase Auth URL (for token verification in n8n workflows)
# Format: https://<project-ref>.supabase.co/auth/v1/user
SUPABASE_AUTH_URL=https://your-project-ref.supabase.co/auth/v1/user
