{
  "id": "logging",
  "name": "Logging",
  "nodes": [
    {
      "id": "45f65f28-98bb-45fb-b43a-a08905974a52",
      "name": "Logging Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "log",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 200
            }
          }
        }
      },
      "webhookId": "b5174645-ac17-4257-909f-d2c7f94fbf15"
    },
    {
      "id": "6e59b0a8-e6f0-4d88-bfc8-ba91159bf525",
      "name": "Insert Workflow Run Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_runs (workflow_name, status, input_payload, output_payload, error_message, duration_ms, triggered_by) VALUES ($1, $2, $3::jsonb, $4::jsonb, $5, $6, $7::uuid) RETURNING id",
        "options": {
          "queryReplacement": "={{ $json.body.workflowName }}, {{ $json.body.status }}, {{ $json.body.inputPayload }}, {{ $json.body.outputPayload }}, {{ $json.body.errorMessage }}, {{ $json.body.durationMs }}, {{ $json.body.triggeredBy }}"
        }
      }
    },
    {
      "id": "9607ee25-dce7-4f7c-94c9-0450126b50e5",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "id": "={{ $json.id }}",
          "logged": true
        }
      }
    }
  ],
  "connections": {
    "Logging Webhook": {
      "main": [
        [
          {
            "node": "Insert Workflow Run Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Workflow Run Log": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}