{
  "workflow": {
    "id": "CIaScBuCOYNo9OE1",
    "name": "Token Refresh Workflow",
    "active": false,
    "webhookUrl": "https://aman01.app.n8n.cloud/webhook/token-refresh",
    "webhookMethod": "POST",
    "path": "token-refresh",
    "nodeCount": 10,
    "description": "Refreshes expiring Meta long-lived access tokens. Called by Publish workflows when token is expired or near expiry.",
    "nodes": [
      { "name": "Token Refresh Webhook", "type": "webhook" },
      { "name": "Fetch Account", "type": "postgres" },
      { "name": "Refresh Meta Token", "type": "httpRequest" },
      { "name": "Check Refresh Success", "type": "if" },
      { "name": "Update Token", "type": "postgres" },
      { "name": "Log Success", "type": "postgres" },
      { "name": "Respond Success", "type": "respondToWebhook" },
      { "name": "Log Failure", "type": "postgres" },
      { "name": "Mark Account Expired", "type": "postgres" },
      { "name": "Respond Failure", "type": "respondToWebhook" }
    ]
  }
}
