{
  "id": "media-upload",
  "name": "Media Upload",
  "nodes": [
    {
      "id": "820b662e-324e-485d-8c82-5a14a32913d1",
      "name": "Media Upload Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "media-upload",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 200
            }
          }
        }
      },
      "webhookId": "ef10d56a-8e86-4547-b6e1-c4cdbbb6ffa1"
    },
    {
      "id": "d963ca82-5dbb-406b-a583-f2faaf96e30e",
      "name": "Insert Media Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO media_assets (user_id, file_url, file_type) VALUES ($1::uuid, $2, $3) RETURNING id, file_url, file_type, created_at",
        "options": {
          "queryReplacement": "={{ $json.body.userId }}, {{ $json.body.fileUrl }}, {{ $json.body.fileType }}"
        }
      }
    },
    {
      "id": "1c910cdf-fa2a-4011-9113-2c21000cc9d9",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "id": "={{ $json.id }}",
          "file_url": "={{ $json.file_url }}",
          "file_type": "={{ $json.file_type }}",
          "created_at": "={{ $json.created_at }}"
        }
      }
    }
  ],
  "connections": {
    "Media Upload Webhook": {
      "main": [
        [
          {
            "node": "Insert Media Asset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Media Asset": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}