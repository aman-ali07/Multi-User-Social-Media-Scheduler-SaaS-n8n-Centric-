{
  "id": "token-refresh",
  "name": "Token Refresh",
  "nodes": [
    {
      "id": "05c428f5-9dc6-43e7-b200-e4bec8eccab5",
      "name": "Token Refresh Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "token-refresh",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 200
            }
          }
        }
      },
      "webhookId": "137a8463-6bc9-4922-a236-a060121960aa"
    },
    {
      "id": "17208b30-8d28-42d3-9f89-30ce3e9006b9",
      "name": "Refresh Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        300,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/oauth/access_token?grant_type=fb_exchange_token&client_id={{ $env.FACEBOOK_APP_ID }}&client_secret={{ $env.FACEBOOK_APP_SECRET }}&fb_exchange_token={{ $json.body.accessToken }}",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "85a3c888-2cf8-4461-96ac-a3b1c1de6e83",
      "name": "Refresh Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 200
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "57e63dc0-f8a1-43e9-a09c-743ccb7e343d",
      "name": "Update Token",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        700,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE social_accounts SET access_token = $1, token_expires_at = $2::timestamptz, updated_at = NOW() WHERE id = $3::uuid",
        "options": {
          "queryReplacement": "={{ $json.body.access_token }}, {{ new Date(Date.now() + $json.body.expires_in * 1000).toISOString() }}, {{ $(\"Token Refresh Webhook\").item.json.body.accountId }}"
        }
      }
    },
    {
      "id": "254aaf27-5af5-4b30-88a5-4ef7a20594a6",
      "name": "Log Refresh",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO token_refresh_log (account_id, status, error_message) VALUES ($1::uuid, $2, $3)",
        "options": {
          "queryReplacement": "={{ $(\"Token Refresh Webhook\").item.json.body.accountId }}, success, NULL"
        }
      }
    },
    {
      "id": "27b2ac02-939b-462a-9eec-292ee3c86139",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "success": true
        }
      }
    },
    {
      "id": "97b6fdea-24e9-4163-a946-586eb7b56dc7",
      "name": "Log Failed",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        700,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO token_refresh_log (account_id, status, error_message) VALUES ($1::uuid, 'failed', $2)",
        "options": {
          "queryReplacement": "={{ $(\"Token Refresh Webhook\").item.json.body.accountId }}, {{ $json.body.error?.message || \"Token refresh failed\" }}"
        }
      }
    },
    {
      "id": "b6ee7593-5adf-4be0-a2ea-2395ed5d7c46",
      "name": "Mark Account Expired",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        450
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE social_accounts SET status = 'expired', updated_at = NOW() WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $(\"Token Refresh Webhook\").item.json.body.accountId }}"
        }
      }
    },
    {
      "id": "aad2908f-c381-4b5a-a72e-39371d3c60e9",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "success": false,
          "error": "={{ $json.body?.error?.message || \"Token refresh failed\" }}"
        }
      }
    }
  ],
  "connections": {
    "Token Refresh Webhook": {
      "main": [
        [
          {
            "node": "Refresh Token",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh Token": {
      "main": [
        [
          {
            "node": "Refresh Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Refresh Success?": {
      "main": [
        [
          {
            "node": "Update Token",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Update Token": {
      "main": [
        [
          {
            "node": "Log Refresh",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Refresh": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Failed": {
      "main": [
        [
          {
            "node": "Mark Account Expired",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Account Expired": {
      "main": [
        [
          {
            "node": "Respond Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}