{
  "id": "retry-handler",
  "name": "Retry Handler",
  "nodes": [
    {
      "id": "a0418e16-1ee0-4f32-8b35-b92142b77aee",
      "name": "Retry Handler Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "retry",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 200
            }
          }
        }
      },
      "webhookId": "9de8b6bb-2d87-41ec-8492-55942584c21b"
    },
    {
      "id": "83782817-47d0-458f-8bdd-58f5f6d22a6c",
      "name": "Check Post Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, retry_count, max_retries FROM scheduled_posts WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $json.body.postId }}"
        }
      }
    },
    {
      "id": "7f43e7f0-a2af-4bc1-ab60-64f4f3e5ef9f",
      "name": "Retries Remaining?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.retry_count }}",
              "operator": {
                "type": "number",
                "operation": "lessThan"
              },
              "rightValue": "={{ $json.max_retries }}"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "e16dd04b-547f-4eca-a26a-5b45872928ac",
      "name": "Compute Backoff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "code": "const retryCount = $json.retry_count;\nconst delayMinutes = Math.pow(2, retryCount) * 5;\nconst retryAt = new Date(Date.now() + delayMinutes * 60 * 1000).toISOString();\nreturn [{ json: { retryAt, delayMinutes } }];"
      }
    },
    {
      "id": "a26b96bf-af1e-4b02-806b-8b4cb74426a8",
      "name": "Reschedule Post",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE scheduled_posts SET status = 'scheduled', schedule_at = $1::timestamptz, updated_at = NOW() WHERE id = $2::uuid",
        "options": {
          "queryReplacement": "={{ $json.retryAt }}, {{ $(\"Check Post Status\").item.json.id }}"
        }
      }
    },
    {
      "id": "74b9a144-7aae-4a61-b091-03ce60a07fc3",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        900,
        450
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "action": "={{ $json.delayMinutes ? \"retry\" : \"exhausted\" }}",
          "postId": "={{ $(\"Check Post Status\").item.json.id }}"
        }
      }
    },
    {
      "id": "66b7b03e-052e-4e34-830f-f3c511adda84",
      "name": "Call Failure Handler",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        700,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_URL }}/webhook/failure-handler",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "postId": "={{ $json.body.postId }}",
          "workflowName": "={{ $json.body.platform }}-publish",
          "error": "={{ $json.body.error }}",
          "attemptNumber": "={{ $json.body.attemptNumber || 1 }}",
          "platform": "={{ $json.body.platform }}",
          "source": "Retry Handler"
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Retry Handler Webhook": {
      "main": [
        [
          {
            "node": "Check Post Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Post Status": {
      "main": [
        [
          {
            "node": "Retries Remaining?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Retries Remaining?": {
      "main": [
        [
          {
            "node": "Compute Backoff",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Call Failure Handler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compute Backoff": {
      "main": [
        [
          {
            "node": "Reschedule Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reschedule Post": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Failure Handler": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}