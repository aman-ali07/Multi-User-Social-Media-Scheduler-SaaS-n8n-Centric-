{
  "workflow": {
    "id": "W12FnZr7RAW7cLiH",
    "name": "Retry Handler Workflow",
    "active": false,
    "webhookUrl": "https://aman01.app.n8n.cloud/webhook/retry",
    "webhookMethod": "POST",
    "path": "retry",
    "nodeCount": 10,
    "description": "Exponential backoff retry (1m/5m/30m). Reschedules post for later or marks permanently failed.",
    "nodes": [
      { "name": "Retry Webhook", "type": "webhook" },
      { "name": "Fetch Post", "type": "postgres" },
      { "name": "Has Retries Left?", "type": "if" },
      { "name": "Calculate Delay", "type": "code" },
      { "name": "Reschedule Post", "type": "postgres" },
      { "name": "Log Retry", "type": "postgres" },
      { "name": "Respond", "type": "respondToWebhook" },
      { "name": "Mark Permanently Failed", "type": "postgres" },
      { "name": "Log Final Error", "type": "postgres" },
      { "name": "Respond No Retries", "type": "respondToWebhook" }
    ]
  }
}
