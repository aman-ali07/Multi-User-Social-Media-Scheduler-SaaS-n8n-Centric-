{
  "id": "oauth-callback",
  "name": "OAuth Callback",
  "nodes": [
    {
      "id": "c0101e95-da48-4846-92da-b22e255483fb",
      "name": "OAuth Callback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "oauth-callback",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 302
            }
          },
          "rawBody": true
        }
      },
      "webhookId": "03892428-3717-4541-998f-53945b24f0ff"
    },
    {
      "id": "565d60dc-57a4-4afc-810c-c438bb796de2",
      "name": "Lookup OAuth State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, user_id, code_verifier, platform FROM oauth_state WHERE state = $1 AND used = false AND expires_at > NOW() LIMIT 1",
        "options": {
          "queryReplacement": "={{ $json.query.state }}"
        }
      }
    },
    {
      "id": "159c0c00-44c4-4263-acd7-e92dbc4fce7a",
      "name": "State Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c5293a6c-d8cc-4577-92a9-c4be84280dfa",
      "name": "Exchange Code for Token",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        700,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.FACEBOOK_TOKEN_URL }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "client_id",
              "value": "={{ $env.FACEBOOK_APP_ID }}"
            },
            {
              "name": "client_secret",
              "value": "={{ $env.FACEBOOK_APP_SECRET }}"
            },
            {
              "name": "redirect_uri",
              "value": "={{ $env.N8N_WEBHOOK_URL }}/webhook/oauth-callback"
            },
            {
              "name": "code",
              "value": "={{ $json.query.code }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "95c879f2-ffc1-49c7-8cf2-3fb64e76911b",
      "name": "Token Exchanged?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        900,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statusCode }}",
              "operator": {
                "type": "number",
                "operation": "equals"
              },
              "rightValue": 200
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "78aa60a0-be41-486f-ae65-0c9a82cc31c2",
      "name": "Fetch User Pages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://graph.facebook.com/v21.0/me/accounts?access_token={{ $(\"Exchange Code for Token\").item.json.body.access_token }}&fields=id,name,instagram_business_account,access_token",
        "authentication": "none",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "5c2d0cab-96f1-44d3-87f7-d9aa17263a6b",
      "name": "Store Account Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "code": "const exchange = $('Exchange Code for Token').item.json;\nconst pages = $('Fetch User Pages').item.json.body?.data || [];\nconst stateData = $('Lookup OAuth State').item.json;\nconst longToken = exchange.body.access_token;\nconst expiresAt = new Date(Date.now() + (exchange.body.expires_in || 5184000) * 1000).toISOString();\n\nconst records = pages.map(page => ({\n  user_id: stateData.user_id,\n  platform: 'facebook',\n  page_id: page.id,\n  page_name: page.name,\n  ig_user_id: page.instagram_business_account?.id || null,\n  ig_username: null,\n  access_token: page.access_token || 'missing',\n  token_expires_at: expiresAt,\n  status: 'active'\n}));\n\nreturn records.map(r => ({ json: r }));"
      }
    },
    {
      "id": "7381b103-128a-482b-93cd-2e9b20ad36e9",
      "name": "Insert Social Accounts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO social_accounts (user_id, platform, page_id, page_name, ig_user_id, access_token, token_expires_at, status) VALUES ($1::uuid, $2::platform_enum, $3, $4, $5, $6, $7::timestamptz, $8::account_status_enum) ON CONFLICT (user_id, platform, page_id) DO UPDATE SET access_token = EXCLUDED.access_token, page_name = EXCLUDED.page_name, ig_user_id = EXCLUDED.ig_user_id, token_expires_at = EXCLUDED.token_expires_at, status = EXCLUDED.status, updated_at = NOW()",
        "options": {
          "queryReplacement": "={{ $json.user_id }}, {{ $json.platform }}, {{ $json.page_id }}, {{ $json.page_name }}, {{ $json.ig_user_id }}, {{ $json.access_token }}, {{ $json.token_expires_at }}, {{ $json.status }}"
        }
      }
    },
    {
      "id": "829d84eb-133c-48e9-9d6c-3d5ace1dbecc",
      "name": "Mark State Used",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE oauth_state SET used = true WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ $(\"Lookup OAuth State\").item.json.id }}"
        }
      }
    },
    {
      "id": "4282c3e6-4d3b-4901-91da-e39a1f1f992d",
      "name": "Redirect Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1900,
        300
      ],
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "={{ $env.FRONTEND_URL }}/accounts?success=connected"
      }
    },
    {
      "id": "7fedb969-cdaa-4b68-a592-789c83fa3cc1",
      "name": "Redirect Token Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1100,
        450
      ],
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "={{ $env.FRONTEND_URL }}/accounts?error=token_exchange_failed"
      }
    },
    {
      "id": "23f5505f-a2f6-42f1-9824-3a583dcd171b",
      "name": "Redirect Invalid",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        700,
        450
      ],
      "parameters": {
        "respondWith": "redirect",
        "redirectURL": "={{ $env.FRONTEND_URL }}/accounts?error=invalid_state"
      }
    }
  ],
  "connections": {
    "OAuth Callback Webhook": {
      "main": [
        [
          {
            "node": "Lookup OAuth State",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup OAuth State": {
      "main": [
        [
          {
            "node": "State Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "State Valid?": {
      "main": [
        [
          {
            "node": "Exchange Code for Token",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Redirect Invalid",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Exchange Code for Token": {
      "main": [
        [
          {
            "node": "Token Exchanged?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Token Exchanged?": {
      "main": [
        [
          {
            "node": "Fetch User Pages",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Redirect Token Failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch User Pages": {
      "main": [
        [
          {
            "node": "Store Account Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store Account Data": {
      "main": [
        [
          {
            "node": "Insert Social Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Social Accounts": {
      "main": [
        [
          {
            "node": "Mark State Used",
            "type": "main",
            "index": 0
          }
        ]
      ]
