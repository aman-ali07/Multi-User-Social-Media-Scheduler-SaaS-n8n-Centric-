{
  "id": "logging",
  "name": "Logging",
  "nodes": [
    {
      "id": "55ec7a31-b3e7-41b9-8d48-b41399d32fb3",
      "name": "Logging Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "log",
        "authentication": "none",
        "responseMode": "onReceived",
        "options": {
          "responseCode": {
            "values": {
              "responseCode": 200
            }
          }
        }
      },
      "webhookId": "a2fa9128-084e-43ce-919e-e09490e290ac"
    },
    {
      "id": "91206776-6740-42e5-aac8-51759c7822aa",
      "name": "Insert Workflow Run Log",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_runs (workflow_name, status, input_payload, output_payload, error_message, duration_ms, triggered_by) VALUES ($1, $2, $3::jsonb, $4::jsonb, $5, $6, $7::uuid) RETURNING id",
        "options": {
          "queryReplacement": "={{ $json.body.workflowName }}, {{ $json.body.status }}, {{ $json.body.inputPayload }}, {{ $json.body.outputPayload }}, {{ $json.body.errorMessage }}, {{ $json.body.durationMs }}, {{ $json.body.triggeredBy }}"
        }
      }
    },
    {
      "id": "d01a6571-e09c-40d3-8718-d12eac59b053",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        500,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": {
          "id": "={{ $json.id }}",
          "logged": true
        }
      }
    }
  ],
  "connections": {
    "Logging Webhook": {
      "main": [
        [
          {
            "node": "Insert Workflow Run Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Workflow Run Log": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}