{
  "id": "cron-scheduler",
  "name": "Cron Scheduler",
  "nodes": [
    {
      "id": "bbfc14cc-0f11-46ac-a4e9-70db26c5df5a",
      "name": "Every Minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        100,
        300
      ],
      "parameters": {
        "rule": {
          "interval": 1
        }
      }
    },
    {
      "id": "351ba62a-267e-4ab7-a97d-6d20e8c94640",
      "name": "Fetch Pending Posts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        300,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT sp.id, sp.user_id, sp.account_id, sp.caption, sp.platforms, sp.schedule_at, sp.timezone, sa.access_token, sa.page_id, sa.ig_user_id, sa.platform AS account_platform, sa.status AS account_status FROM scheduled_posts sp JOIN social_accounts sa ON sa.id = sp.account_id WHERE sp.status = 'scheduled' AND sp.schedule_at <= NOW() AND sp.deleted_at IS NULL AND sa.status = 'active' ORDER BY sp.schedule_at ASC LIMIT 5",
        "options": {
          "queryReplacement": ""
        }
      }
    },
    {
      "id": "7ac667fb-e359-42ab-99be-3ca5590c142e",
      "name": "Has Pending Posts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "1ac4d068-9ebf-446b-9050-af9ad3063cf1",
      "name": "Fetch Post Media",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ma.file_url, ma.file_type FROM post_media pm JOIN media_assets ma ON ma.id = pm.media_id WHERE pm.post_id = $1::uuid ORDER BY pm.sort_order ASC LIMIT 1",
        "options": {
          "queryReplacement": "={{ $json.id }}"
        }
      }
    },
    {
      "id": "69811be7-74b3-47de-a946-6763efb99d5b",
      "name": "Build Dispatch Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "code": "const post = $json;\nconst media = $('Fetch Post Media').item?.json || {};\nreturn [{ json: {\n  postId: post.id,\n  userId: post.user_id,\n  accessToken: post.access_token,\n  pageId: post.page_id,\n  igUserId: post.ig_user_id,\n  caption: post.caption || '',\n  mediaUrl: media.file_url || '',\n  mediaType: media.file_type || '',\n  accountPlatform: post.account_platform\n}}];"
      }
    },
    {
      "id": "362a6b2c-2d0d-4b6d-8a88-7d96b380951a",
      "name": "Route by Platform",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1300,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.accountPlatform }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "facebook"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "65f468aa-b2ca-4dee-98a3-625ce95e9980",
      "name": "Dispatch Facebook Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1500,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_URL }}/webhook/facebook-publish",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "postId": "={{ $json.postId }}",
          "userId": "={{ $json.userId }}",
          "accessToken": "={{ $json.accessToken }}",
          "pageId": "={{ $json.pageId }}",
          "caption": "={{ $json.caption }}",
          "mediaUrl": "={{ $json.mediaUrl }}",
          "mediaType": "={{ $json.mediaType }}"
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "8dd040b9-4353-4160-993d-60734973b8a6",
      "name": "Process Each Post",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        700,
        300
      ],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "d9f5ca26-f5a1-4d82-b72a-e9f517b70a48",
      "name": "Dispatch Instagram Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1500,
        450
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_URL }}/webhook/instagram-publish",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": {
          "postId": "={{ $json.postId }}",
          "userId": "={{ $json.userId }}",
          "accessToken": "={{ $json.accessToken }}",
          "igUserId": "={{ $json.igUserId }}",
          "caption": "={{ $json.caption }}",
          "mediaUrl": "={{ $json.mediaUrl }}",
          "mediaType": "={{ $json.mediaType }}"
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Every Minute": {
      "main": [
        [
          {
            "node": "Fetch Pending Posts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Pending Posts": {
      "main": [
        [
          {
            "node": "Has Pending Posts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Pending Posts?": {
      "main": [
        [
          {
            "node": "Process Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Post Media": {
      "main": [
        [
          {
            "node": "Build Dispatch Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Dispatch Payload": {
      "main": [
        [
          {
            "node": "Route by Platform",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Platform": {
      "main": [
        [
          {
            "node": "Dispatch Facebook Publish",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Dispatch Instagram Publish",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Facebook Publish": {
      "main": [
        [
          {
            "node": "Process Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process Each Post": {
      "main": [
        [],
        [
          {
            "node": "Fetch Post Media",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Instagram Publish": {
      "main": [
        [
          {
            "node": "Process Each Post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}